# Railway / server environment
#
# Stripe (factopiatrivia)
# 1. Developers → API keys → Secret key (start with sk_test_…)
# 2. Optional: Developers → Webhooks → endpoint
#    URL: https://factopia-production.up.railway.app/api/stripe/webhook
#    Event: checkout.session.completed
# 3. Paste webhook signing secret (whsec_…)
#
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://factopia.net
# Optional: custom Price ID. If empty, Checkout uses 99 SEK inline.
# STRIPE_PARTY_PRICE_ID=price_...
# STRIPE_PARTY_AMOUNT_ORE=9900
#
# Promo codes (comma-separated). Leave empty in production when Stripe is live.
# PARTY_PASS_CODES=
