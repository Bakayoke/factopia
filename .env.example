# Railway / server environment
PUBLIC_APP_URL=https://factopia.net

# Persistence (rooms across restarts)
# Prefer Redis on Railway: add a Redis plugin and set REDIS_URL.
# Also accepts REDIS_PRIVATE_URL / REDIS_PUBLIC_URL.
# REDIS_URL=redis://default:…@….railway.internal:6379
# Or mount a volume at /data (auto-detected) or set:
# FACTOPIA_DATA_DIR=/data
